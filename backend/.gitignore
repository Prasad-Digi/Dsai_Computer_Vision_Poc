# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# ---- Env / secrets ----
.env
credentials/cctv_credentials.json

# ---- Model weights (large binaries - download via ultralytics, don't commit) ----
data/weights/*.pt
data/weights/*.onnx
data/weights/*.engine
mobileclip*.ts
mobileclip*.pt

# ---- Test/input videos (can be large; keep repo light) ----
data/videos/*
!data/videos/.gitkeep

# ---- Generated outputs ----
outputs/processed_videos/*
outputs/reports/*
!outputs/processed_videos/.gitkeep
!outputs/reports/.gitkeep

# ---- OS / IDE ----
.DS_Store
.vscode/
*.log
