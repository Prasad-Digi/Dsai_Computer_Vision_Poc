# Copy this file to ".env" and adjust values as needed.
# NEVER commit the real ".env" file (it is already in .gitignore).

# ---------- Server ----------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Models ----------
# Detection + tracking model (people & vehicles). Options: yolo26n / yolo26s / yolo26m / yolo26l / yolo26x
DETECTION_MODEL=yolo26m.pt
# Open-vocabulary model used to spot attributes that have no fixed COCO class
# (cap, jacket, uniform, safety vest, shoes, boots ...)
ATTRIBUTE_MODEL=yoloe-26m-seg.pt
DEVICE=cpu                 # "cpu" or "cuda:0" (use cuda:0 if you have an NVIDIA GPU + CUDA installed)
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.5

# ---------- Paths ----------
VIDEO_DIR=data/videos
WEIGHTS_DIR=data/weights
OUTPUT_DIR=outputs
CCTV_CREDENTIALS_FILE=credentials/cctv_credentials.json

# ---------- Business logic ----------
# A person is only counted as "present" once tracked for this many seconds (filters out people just passing by camera edge)
MIN_DWELL_SECONDS_TO_COUNT=1.0
# Attribute model only re-checks each tracked person every N frames (perf optimisation)
ATTRIBUTE_RECHECK_EVERY_N_FRAMES=10
